<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CV — Eu Sarapinto</title>
  <meta name="description" content="Welcome to Eu Sarapinto's corner of the internet. A grid of original comics, illustrations and visual thoughts, completely free of annoying algorithms.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Eu Sarapinto">
  <meta property="og:description" content="Welcome to Eu Sarapinto's corner of the internet. A grid of original comics, illustrations and visual thoughts, completely free of annoying algorithms.">
  <meta property="og:url" content="https://eusarapinto.github.io">
  <meta property="og:image" content="https://eusarapinto.github.io/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Eu Sarapinto">
  <meta name="twitter:description" content="Welcome to Eu Sarapinto's corner of the internet. A grid of original comics, illustrations and visual thoughts, completely free of annoying algorithms.">
  <meta name="twitter:image" content="https://eusarapinto.github.io/og-image.png">
  <link rel="icon" type="image/svg+xml" href="../juliafavicon.svg">
  <link rel="apple-touch-icon" href="../juliafavicon.svg">
  <style>
    /* ── SELF-HOSTED FONTS ── */
    @font-face {
      font-family: 'Inter';
      src: url('../fonts/Intervariablefont.woff2') format('woff2');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Fraunces';
      src: url('../fonts/Frauncesvariablefont.woff2') format('woff2');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --black: #111; --white: #fff; --gray: #e8e8e4; --light-gray: #f4f4f2; --mid-gray: #666; --red: #ff0000; }
    html { font-size: 16px; }
    body { font-optical-sizing: auto; font-family: 'Inter', sans-serif; font-weight: 300; background: var(--white); color: var(--black); min-height: 100vh; display: flex; flex-direction: column; }

    header { display: flex; align-items: center; justify-content: space-between; padding: 28px 150px; position: sticky; top: 0; background: var(--white); z-index: 100; border-bottom: 1px solid transparent; transition: border-color 0.3s; }
    header.scrolled { border-color: var(--gray); }
    @media (max-width: 1100px) { header { padding: 24px 40px; } }
    @media (max-width: 600px) { header { padding: 20px; } }

    .logo { text-decoration: none; display: flex; align-items: center; }
    .logo-img { height: 28px; width: auto; display: block; }
    @media (max-width: 600px) { .logo-img { height: 22px; } }

    nav { display: flex; align-items: center; gap: 32px; }
    nav a { font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; color: var(--black); text-decoration: none; transition: color 0.2s; }
    nav a:hover { color: var(--red); }
    nav a.active { color: var(--red); font-weight: 800; }

    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border: none; padding: 4px; }
    .hamburger span { display: block; width: 24px; height: 1.5px; background: var(--black); border-radius: 999px; }
    .mobile-menu { display: none; position: fixed; inset: 0; background: var(--white); z-index: 200; flex-direction: column; align-items: center; justify-content: center; gap: 40px; }
    .mobile-menu.open { display: flex; }
    .mobile-menu a { font-family: 'Inter', sans-serif; font-size: 1.1rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: var(--black); text-decoration: none; }
    .mobile-menu a.active { color: var(--red); font-weight: 800; }
    .mobile-menu-close { position: absolute; top: 8px; right: 8px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: none; border: none; cursor: pointer; color: var(--black); }
    .mobile-menu-close svg { width: 22px; height: 22px; }
    @media (max-width: 600px) { nav { display: none; } .hamburger { display: flex; } }

    main { flex: 1; }

    .cv-wrapper {
      padding: 80px 150px 0 calc(150px + (100vw - 300px - 48px) / 5 + 12px);
    }
    @media (max-width: 1100px) { .cv-wrapper { padding: 60px 40px 0; } }
    @media (max-width: 600px) { .cv-wrapper { padding: 40px 24px 0; } }

    .cv-section { margin-bottom: 40px; padding-bottom: 40px; border-bottom: 1px solid var(--gray); }
    .cv-section:last-child { margin-bottom: 24px; padding-bottom: 0; border-bottom: none; }

    .cv-section-title {
      font-family: 'Inter', sans-serif;
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--mid-gray);
      margin-bottom: 20px;
    }

    .cv-entries { display: flex; flex-direction: column; gap: 20px; }

    .cv-entry { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; }

    .cv-entry-body { flex: 1; min-width: 0; }

    .cv-entry-title {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--black);
      margin-bottom: 3px;
    }

    .cv-entry-sub {
      font-size: 0.78rem;
      color: var(--mid-gray);
      line-height: 1.5;
    }

    .cv-entry-sub em { font-style: italic; }

    .cv-entry-year {
      font-size: 0.78rem;
      color: var(--mid-gray);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .illustrations {
      padding: 0 150px 80px calc(150px + (100vw - 300px - 48px) / 5 + 12px);
      display: flex;
      gap: 24px;
      align-items: flex-end;
      justify-content: center;
    }

    .illustrations img {
      width: 120px;
      height: auto;
      display: block;
      flex-shrink: 0;
    }

    @media (max-width: 1100px) { .illustrations { padding: 0 40px 60px; gap: 16px; } .illustrations img { width: 90px; } }
    @media (max-width: 600px) { .illustrations { padding: 0 24px 40px; gap: 10px; flex-wrap: wrap; justify-content: center; } .illustrations img { width: 70px; } .illustrations img.hide-mobile { display: none !important; } }


    /* ── FOOTER ── */
    footer { padding: 64px 150px 0; border-top: 1px solid var(--gray); }
    @media (max-width: 1100px) { footer { padding: 56px 40px 0; } }
    @media (max-width: 600px) { footer { padding: 40px 24px 0; } }

    .footer-cols {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
      padding-bottom: 48px;
    }
    @media (max-width: 900px) { .footer-cols { grid-template-columns: repeat(2, 1fr); gap: 40px 32px; } }
    @media (max-width: 560px) { .footer-cols { grid-template-columns: 1fr; gap: 32px; padding-bottom: 36px; } }

    .footer-col-title {
      font-family: 'Inter', sans-serif;
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--mid-gray);
      margin-bottom: 20px;
    }

    .footer-list { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }

    .footer-list a {
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 400;
      color: var(--black);
      text-decoration: none;
      transition: color 0.2s;
    }
    .footer-list a:hover { color: var(--red); }

    .footer-note {
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 400;
      color: var(--black);
      margin-bottom: 14px;
    }

    .footer-soon { font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 400; color: var(--black); }

    .footer-email {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 400;
      color: var(--black);
      position: relative;
    }

    .footer-copy-btn {
      --hit-pad: 6px;
      box-sizing: content-box;
      width: 12px; height: 14px;
      background: none; border: none; cursor: pointer;
      color: var(--black); display: flex; align-items: center; justify-content: center;
      position: relative;
      padding: var(--hit-pad);
      margin: calc(-1 * var(--hit-pad));
      transition: color 0.2s, background 0.15s; flex-shrink: 0;
      border-radius: 6px;
    }
    @media (max-width: 600px) {
      .footer-copy-btn { --hit-pad: 16px; }
    }
    @media (hover: hover) {
      .footer-copy-btn:hover { color: var(--red); }
    }
    .footer-copy-btn svg { width: 16px; height: auto; display: block; }
    .footer-copy-btn .icon-copy svg { width: 12px; height: 14px; }
    .footer-copy-btn .icon-check svg { width: 11px; height: 7.5px; }
    .footer-copy-btn .icon-check { display: none; }
    .footer-copy-btn.copied .icon-copy { display: none; }
    .footer-copy-btn.copied .icon-check { display: block; }

    .footer-tooltip {
      position: absolute;
      bottom: calc(100% - var(--hit-pad) + 8px);
      left: 50%;
      transform: translateX(-50%);
      background: var(--black);
      color: var(--white);
      font-family: 'Inter', sans-serif;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      padding: 5px 10px;
      border-radius: 4px;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s;
    }
    .footer-tooltip.visible { opacity: 1; }
    .footer-tooltip::after {
      content: '';
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      border: 5px solid transparent;
      border-top-color: var(--black);
    }

    @media (max-width: 600px) {
      .footer-sep { display: none; }
      .footer-break { display: block; margin-top: 4px; }
    }

    .footer-bottom {
      border-top: 1px solid var(--gray);
      padding: 24px 0 32px;
      text-align: center;
      font-family: 'Inter', sans-serif;
      font-size: 0.78rem;
      font-weight: 300;
      color: var(--mid-gray);
      letter-spacing: 0.03em;
    }
    .footer-bottom-privacy { color: var(--black); font-weight: 500; text-decoration: none; }
    @media (hover: hover) { .footer-bottom-privacy:hover { color: var(--red); } }

    /* ── BUTTON (shared with Enough Julia / Bio) ── */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 43px; padding: 0 16px; background: var(--black); color: var(--white); font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; border: none; border-radius: 8px; cursor: pointer; text-decoration: none; transition: background 0.2s; }
    @media (hover: hover) { .btn:hover { background: var(--red); } }

    /* ── NEWSLETTER FORM (footer) ── */
    .newsletter-form { display: flex; flex-wrap: wrap; gap: 8px; }
    .newsletter-field { position: relative; flex: 999 1 140px; min-width: 0; }
    .newsletter-input {
      width: 100%;
      height: 43px;
      padding: 0 16px;
      border: 1px solid var(--gray);
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 400;
      color: var(--black);
      background: var(--white);
    }
    .newsletter-input::placeholder { color: var(--mid-gray); }
    .newsletter-input:focus { outline: none; border-color: var(--black); }
    .newsletter-input.invalid { border-color: var(--red); }
    /* iOS Safari auto-zooms on focus when an input's font-size is under 16px */
    @media (max-width: 600px) { .newsletter-input { font-size: 16px; } }
    .newsletter-submit { flex: 1 1 auto; }

    /* on-brand replacement for the browser's native "please fill out this
       field" validation bubble */
    .field-tooltip {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      background: var(--black);
      color: var(--white);
      font-family: 'Inter', sans-serif;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      padding: 6px 10px;
      border-radius: 4px;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(-4px);
      pointer-events: none;
      transition: opacity 0.15s, transform 0.15s;
      z-index: 5;
    }
    .field-tooltip.visible { opacity: 1; transform: translateY(0); }
    .field-tooltip::before {
      content: '';
      position: absolute;
      bottom: 100%;
      left: 16px;
      border: 5px solid transparent;
      border-bottom-color: var(--black);
    }
    .newsletter-status {
      margin-top: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 0.78rem;
      font-weight: 400;
      color: var(--mid-gray);
      min-height: 1em;
    }
    .newsletter-status.error { color: var(--red); }
    .footer-cols .footer-col:last-child { container-type: inline-size; }
    .footer-note .txt-short, .newsletter-attribution .txt-short { display: none; }
    @container (max-width: 280px) {
      .footer-note .txt-full { display: none; }
      .footer-note .txt-short { display: inline; }
    }
    @container (max-width: 260px) {
      .newsletter-attribution .txt-full { display: none; }
      .newsletter-attribution .txt-short { display: inline; }
    }

    .newsletter-attribution {
      margin-top: 10px;
      padding-left: 17px;
      font-family: 'Inter', sans-serif;
      font-size: 0.68rem;
      font-weight: 300;
      color: var(--mid-gray);
    }
    .newsletter-attribution a { font-family: 'Inter', sans-serif; color: var(--mid-gray); text-decoration: none; }
    .newsletter-attribution a.privacy-link { color: var(--black); font-weight: 500; }
    @media (hover: hover) { .newsletter-attribution a.privacy-link:hover { color: var(--red); } }
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
  </style>
</head>
<body>

  <header id="header">
    <a href="/" class="logo">
      <img src="../eusarapintologo.svg" alt="eu sarapinto" class="logo-img">
    </a>
    <nav>
      <a href="/">Home</a>
      <a href="/enough-julia">Enough Julia</a>
      <a href="/bio">Bio / Contact</a>
      <a href="/newsletter">Newsletter</a>
      <a href="/cv" class="active">CV</a>
    </nav>
    <button class="hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
        <line x1="21" y1="3" x2="3" y2="21"/><line x1="3" y1="3" x2="21" y2="21"/>
      </svg>
    </button>
    <a href="/">Home</a>
    <a href="/enough-julia">Enough Julia</a>
    <a href="/bio">Bio / Contact</a>
    <a href="/newsletter">Newsletter</a>
    <a href="/cv" class="active">CV</a>
  </div>

  <main>
    <div class="cv-wrapper">

      <div class="cv-section">
        <p class="cv-section-title">Awards</p>
        <div class="cv-entries">
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Bienal internacional de ilustração solidária Ajudaris</p>
              <p class="cv-entry-sub"><em>Who owns whom</em> &nbsp;·&nbsp; Honourable Mention</p>
            </div>
            <span class="cv-entry-year">2017</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Canelas Short Film Festival</p>
              <p class="cv-entry-sub"><em>Insónia</em> &nbsp;·&nbsp; Honourable Mention</p>
            </div>
            <span class="cv-entry-year">2013</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Valadares Short Film Festival</p>
              <p class="cv-entry-sub"><em>Café Utopia</em> &nbsp;·&nbsp; Second Prize</p>
            </div>
            <span class="cv-entry-year">2012</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Oito e Meio Short Film Festival</p>
              <p class="cv-entry-sub"><em>Café Utopia</em> &nbsp;·&nbsp; First Prize</p>
            </div>
            <span class="cv-entry-year">2011</span>
          </div>
        </div>
      </div>

      <div class="cv-section">
        <p class="cv-section-title">Exhibitions</p>
        <div class="cv-entries">
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Plaster: 10th Edition</p>
              <p class="cv-entry-sub">International Festival of Graphic Design — Torun, Poland</p>
            </div>
            <span class="cv-entry-year">2019</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Matinés à Tetris</p>
            </div>
            <span class="cv-entry-year">2018</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Operating Manual for Spaceship Earth</p>
              <p class="cv-entry-sub">FBAUP, oMuseu</p>
            </div>
            <span class="cv-entry-year">2018</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Museu Amadeo de Souza-Cardoso</p>
              <p class="cv-entry-sub">Bienal internacional de ilustração solidária Ajudaris — <em>Who owns whom</em></p>
            </div>
            <span class="cv-entry-year">2017</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Time Lapse</p>
              <p class="cv-entry-sub">Solar: Galeria de Arte Cinemática, Vila do Conde</p>
            </div>
            <span class="cv-entry-year">2017</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Fantasporto</p>
              <p class="cv-entry-sub">Official competition, cinema schools — Café Utopia</p>
            </div>
            <span class="cv-entry-year">2012</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Shortcutz Porto</p>
              <p class="cv-entry-sub">Café Utopia — July 2011</p>
            </div>
            <span class="cv-entry-year">2011</span>
          </div>
        </div>
      </div>

      <div class="cv-section">
        <p class="cv-section-title">Features</p>
        <div class="cv-entries">
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">Ilustrário do Amor Próprio</p>
              <p class="cv-entry-sub">Contributed illustration to an independent publication by Catarina Maia, featuring 69 illustrations of female self-pleasure expressions by 69 Portuguese artists.</p>
            </div>
            <span class="cv-entry-year">2020</span>
          </div>
        </div>
      </div>

      <div class="cv-section">
        <p class="cv-section-title">Press</p>
        <div class="cv-entries">
          <div class="cv-entry">
            <div class="cv-entry-body">
              <p class="cv-entry-title">GQ Magazine</p>
              <p class="cv-entry-sub">Illustration work showcased in May's 2019 edition.</p>
            </div>
            <span class="cv-entry-year">2019</span>
          </div>
        </div>
      </div>

    </div>

    <div class="illustrations">
      <img src="../bio1.svg" alt="">
      <img src="../cv1.svg" alt="">
      <img src="../cv2.svg" alt="">
      <img src="../cv3.svg" alt="">
      <img src="../bio3.svg" alt="" class="hide-mobile">
    </div>

  </main>

  <footer>
    <div class="footer-cols">

      <div class="footer-col">
        <p class="footer-col-title">Site links</p>
        <div class="footer-list">
          <a href="/">Home</a>
          <a href="/enough-julia">Enough Julia</a>
          <a href="/bio">Bio / Contact</a>
          <a href="/newsletter">Newsletter</a>
          <a href="/cv">CV</a>
        </div>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Follow me</p>
        <div class="footer-list">
          <a href="https://instagram.com/eusarapinto" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.tiktok.com/@eusarapinto" target="_blank" rel="noopener">Tik Tok</a>
          <a href="https://www.facebook.com/eusarapinto/" target="_blank" rel="noopener">Facebook</a>
          <a href="https://eusarapinto.tumblr.com/" target="_blank" rel="noopener">Tumblr</a>
        </div>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Talk to me at</p>
        <div class="footer-email">
          <span id="footer-email-text">hi@eusarapinto.com</span>
          <button class="footer-copy-btn" id="footer-copy-btn" aria-label="Copy email">
            <span class="icon-copy">
              <svg width="12" height="14" viewBox="0 0 12 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.23047 12L9.21973 12.2041C9.12421 13.1455 8.37594 13.8937 7.43457 13.9893L7.23047 14H2L1.7959 13.9893C0.854402 13.8938 0.106283 13.1456 0.0107422 12.2041L0 12V4.7998C0 3.69524 0.895431 2.7998 2 2.7998H2.76953V2C2.76953 0.895431 3.66496 1.28851e-07 4.76953 0H10L10.2041 0.0107422C11.2126 0.113139 12 0.964449 12 2V9.2002L11.9893 9.4043C11.8937 10.3457 11.1455 11.0939 10.2041 11.1895L10 11.2002H9.23047V12ZM3.76953 11.2002L3.66699 11.1953C3.1963 11.1474 2.82198 10.7726 2.77441 10.3018L2.76953 10.2002V3.7998H2C1.44771 3.7998 1 4.24752 1 4.7998V12C1.00011 12.5522 1.44778 13 2 13H7.23047C7.78256 12.9998 8.23036 12.5521 8.23047 12V11.2002H3.76953ZM4.76953 1C4.21725 1 3.76953 1.44772 3.76953 2V10.2002H10C10.5521 10.2 10.9999 9.75229 11 9.2002V2C11 1.44781 10.5521 1.00016 10 1H4.76953Z" fill="currentColor" stroke="currentColor" stroke-width="0.2"/>
              </svg>
            </span>
            <span class="icon-check">
              <svg width="12" height="9" viewBox="0 0 12 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.5 4.5L4 8L11.5 0.5" stroke="black" stroke-width="1.21" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="footer-tooltip" id="footer-tooltip">Copied!</span>
          </button>
        </div>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Newsletter</p>
        <p class="footer-note"><span class="txt-full">Join my newsletter to receive updates.</span><span class="txt-short">Join to receive updates.</span></p>
        <form action="https://buttondown.com/api/emails/embed-subscribe/eusarapinto" method="post" class="newsletter-form" id="newsletter-form" novalidate>
          <label for="newsletter-email" class="sr-only">Enter your email</label>
          <div class="newsletter-field">
            <input type="email" name="email" id="newsletter-email" class="newsletter-input" placeholder="Your email" required>
            <span class="field-tooltip" id="newsletter-email-tooltip"></span>
          </div>
          <button type="submit" class="btn newsletter-submit">Join</button>
        </form>
        <p class="newsletter-attribution"><span class="txt-full">Check how data is handled in the <a href="/privacy-policy" class="privacy-link">Privacy Policy</a>.</span><span class="txt-short">Check <a href="/privacy-policy" class="privacy-link">Privacy Policy</a></span></p>
      </div>

    </div>

    <div class="footer-bottom">© 2026 Eu sarapinto<span class="footer-sep"> | </span><span class="footer-break">No cookies, no tracking, just comics. | <a href="/privacy-policy" class="footer-bottom-privacy">Privacy Policy</a></span></div>
  </footer>

  <script>
    window.addEventListener('scroll', () => {
      document.getElementById('header').classList.toggle('scrolled', window.scrollY > 10);
    });
    document.getElementById('hamburger').addEventListener('click', () => {
      document.getElementById('mobile-menu').classList.add('open');
    });
    document.getElementById('mobile-menu-close').addEventListener('click', () => {
      document.getElementById('mobile-menu').classList.remove('open');
    });

    (function setupFooterCopyButton() {
      const btn = document.getElementById('footer-copy-btn');
      const tooltip = document.getElementById('footer-tooltip');
      let resetTimer;

      btn.addEventListener('click', () => {
        const email = document.getElementById('footer-email-text').textContent;
        navigator.clipboard.writeText(email).then(() => {
          clearTimeout(resetTimer);

          btn.classList.add('copied');
          btn.setAttribute('aria-label', 'Copied!');
          btn.blur();
          tooltip.classList.add('visible');

          resetTimer = setTimeout(() => {
            btn.classList.remove('copied');
            btn.setAttribute('aria-label', 'Copy email');
            tooltip.classList.remove('visible');
          }, 3000);
        });
      });
    })();

    // custom on-brand replacement for the browser's native validation bubble
    function setupNewsletterValidation(formId, inputId, tooltipId) {
      const form = document.getElementById(formId);
      const input = document.getElementById(inputId);
      const tip = document.getElementById(tooltipId);
      if (!form || !input || !tip) return;

      function showError(msg) {
        tip.textContent = msg;
        tip.classList.add('visible');
        input.classList.add('invalid');
      }
      function hideError() {
        tip.classList.remove('visible');
        input.classList.remove('invalid');
      }

      form.addEventListener('submit', (e) => {
        if (!input.checkValidity()) {
          e.preventDefault();
          if (input.validity.valueMissing) {
            showError('Please enter your email.');
          } else if (input.validity.typeMismatch) {
            showError('Please enter a valid email.');
          } else {
            showError('Please check your email.');
          }
          input.focus();
        } else {
          hideError();
        }
      });

      input.addEventListener('input', hideError);
      input.addEventListener('blur', hideError);
    }

    setupNewsletterValidation('newsletter-form', 'newsletter-email', 'newsletter-email-tooltip');
  </script>

</body>
</html>
